/* pipeline rail — the signature element */
.cv-rail { display: flex; gap: 0; background: #fff; border: 1px solid var(--cv-line); border-radius: 16px; padding: 18px 20px 16px; margin: 0 0 1.5rem 0; }
.cv-stage { position: relative; flex: 1 1 0; min-width: 0; padding-right: 14px; }
.cv-stage::after { content: ""; position: absolute; top: 14px; left: 36px; right: 8px; height: 2px; background: var(--cv-line); border-radius: 2px; }
.cv-stage:last-child::after { display: none; }
.cv-stage.done::after { background: var(--cv-blue-2); }
.cv-stage.alert::after { background: linear-gradient(90deg, var(--cv-red), var(--cv-blue-2)); }
.cv-stage.skip::after { background: repeating-linear-gradient(90deg, var(--cv-line) 0 5px, transparent 5px 9px); }
.cv-dot { width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #fff; border: 2px solid var(--cv-line); color: var(--cv-muted); font-weight: 700; font-size: 13px; position: relative; z-index: 1; }
.cv-stage.done .cv-dot { background: var(--cv-blue); border-color: var(--cv-blue); color: #fff; }
.cv-stage.alert .cv-dot { background: var(--cv-red); border-color: var(--cv-red); color: #fff; }
.cv-stage.clean .cv-dot { background: var(--cv-green); border-color: var(--cv-green); color: #fff; }
.cv-stage.skip .cv-dot { border-style: dashed; color: #A9B6CA; }
.cv-stage b { display: block; margin-top: 10px; font-size: 14.5px; color: var(--cv-ink); font-weight: 700; }
.cv-stage span { display: block; font-size: 12.8px; color: var(--cv-muted); margin-top: 2px; line-height: 1.4; }
.cv-stage.alert span.cv-val { color: var(--cv-red); font-weight: 600; }
.cv-stage.clean span.cv-val { color: var(--cv-green); font-weight: 600; }
.cv-stage.done span.cv-val { color: var(--cv-blue); font-weight: 600; }
.cv-stage.skip b { color: #8C9AB0; }

/* cards */
