def load_binary_attack_detector(path: str, file_signature: tuple):
    """file_signature invalidates the resource cache when .keras changes."""
    model = keras.models.load_model(path, compile=False)
    if tuple(model.input_shape[1:]) != (32, 32, 3):
        raise ValueError(f"Binary detector expects input shape {model.input_shape}; wanted (None,32,32,3)")
    if tuple(model.output_shape[1:]) != (1,):
        raise ValueError(f"Binary detector must have 1 sigmoid output, got {model.output_shape}")
    return model


def load_detector_threshold():
    """Use threshold saved by the training notebook (default 0.5)."""
    if not os.path.exists(BINARY_DETECTOR_META_PATH):
        return 0.5, False
    with open(BINARY_DETECTOR_META_PATH, "r", encoding="utf-8") as f:
        meta = json.load(f)
    if meta.get("labels") not in (None, {"0": "clean", "1": "attacked"}):
        raise ValueError("Binary detector metadata does not specify 0=clean, 1=attacked")
    threshold = float(meta.get("threshold", 0.5))
    if not (0.0 < threshold < 1.0):
        raise ValueError(f"Invalid detector threshold: {threshold}")
    return threshold, True


