def to_display_rgb(img, kind="float"):
    """Convert a model array or decoded upload into a display-ready uint8 RGB image (display only)."""
    if kind == "float":
        arr = np.clip(np.asarray(img, dtype=np.float32) * 255.0, 0, 255).astype(np.uint8)
    elif kind == "bgr":
        arr = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
    else:
        arr = np.asarray(img).astype(np.uint8)
    h, w = arr.shape[:2]
    if max(h, w) < 160:
        scale = int(np.ceil(256 / max(h, w)))
        arr = cv2.resize(arr, (w * scale, h * scale), interpolation=cv2.INTER_NEAREST)
    elif max(h, w) > 520:
        s = 520 / max(h, w)
        arr = cv2.resize(arr, (max(1, int(w * s)), max(1, int(h * s))), interpolation=cv2.INTER_AREA)
    return arr


def data_uri(img, kind="float"):
    arr = to_display_rgb(img, kind)
    ok, buf = cv2.imencode(".png", cv2.cvtColor(arr, cv2.COLOR_RGB2BGR))
    if not ok:
        return ""
    return "data:image/png;base64," + base64.b64encode(buf.tobytes()).decode("ascii")


