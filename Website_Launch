/* verdict */
.cv-verdict { border-radius: 14px; padding: 18px 20px; border: 1px solid var(--cv-line); background: #fff; margin-bottom: 1rem; }
.cv-verdict .cv-v-label { font-size: 2.1rem; font-weight: 800; color: var(--cv-ink); line-height: 1.1; text-transform: capitalize; letter-spacing: -0.01em; }
.cv-verdict .cv-v-conf { font-size: .98rem; color: var(--cv-muted); margin-top: 4px; }
.cv-verdict.good { border-color: #B6DCCB; background: linear-gradient(180deg, var(--cv-green-tint), #fff 70%); }
.cv-verdict.good .cv-v-label { color: var(--cv-green); }
.cv-verdict.bad { border-color: #EBC1C5; background: linear-gradient(180deg, var(--cv-red-tint), #fff 70%); }
.cv-verdict.bad .cv-v-label { color: var(--cv-red); }
.cv-verdict.blue { border-color: #C5D6F1; background: linear-gradient(180deg, var(--cv-tint), #fff 70%); }

/* probability bars */
.cv-bars { display: flex; flex-direction: column; gap: 9px; margin-top: 4px; }
.cv-bar { display: grid; grid-template-columns: minmax(84px, 120px) 1fr 62px; align-items: center; gap: 12px; font-size: 14px; }
.cv-bar .n { color: var(--cv-text); font-weight: 500; text-transform: capitalize; }
.cv-bar .t { height: 9px; background: var(--cv-line-2); border-radius: 6px; overflow: hidden; }
.cv-bar .f { height: 100%; background: var(--cv-blue-2); border-radius: 6px; }
.cv-bar.top .n { font-weight: 700; color: var(--cv-ink); }
.cv-bar .v { text-align: right; font-variant-numeric: tabular-nums; color: var(--cv-muted); font-weight: 600; }
.cv-bars.red .f { background: var(--cv-red); } .cv-bars.green .f { background: var(--cv-green); }
.cv-bar.dim .f { background: #AFC0DA; }

/* detection meter */
.cv-meter { position: relative; height: 14px; border-radius: 8px; background: var(--cv-line-2); margin: 18px 0 30px; }
.cv-meter .f { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 8px; }
.cv-meter .thr { position: absolute; top: -7px; bottom: -7px; width: 2px; background: var(--cv-ink); }
.cv-meter .thr i { position: absolute; top: 30px; left: 50%; transform: translateX(-50%); font-style: normal; font-size: 12px; color: var(--cv-muted); white-space: nowrap; }
.cv-big { font-size: 2.6rem; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }

/* status chips */
.cv-chip { display: inline-flex; align-items: center; gap: 7px; padding: 5px 12px; border-radius: 999px; font-size: 13.5px; font-weight: 600; border: 1px solid transparent; }
.cv-chip.red { background: var(--cv-red-tint); color: var(--cv-red); border-color: #EFC9CC; }
.cv-chip.green { background: var(--cv-green-tint); color: var(--cv-green); border-color: #BFE0D2; }
.cv-chip.blue { background: var(--cv-tint); color: var(--cv-blue); border-color: #CADAF3; }
.cv-chip.amber { background: var(--cv-amber-tint); color: var(--cv-amber); border-color: #F0D9AE; }
