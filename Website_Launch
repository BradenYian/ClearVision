def update_final_from_reconstruction(alpha: float):
    """Recompute mix and final prediction when the slider changes."""
    ss = st.session_state
    if ss.x_adv is None or ss.x_rec is None:
        raise RuntimeError("Attacked input/reconstruction not ready")
    if ss.norm_label not in ("Linf", "L2"):
        raise RuntimeError("Norm classification missing; cannot select final image")
    if clf is None:
        raise RuntimeError("Base classifier not loaded")
    x_mix, x_final, mode = compute_mix_if_needed(
        ss.x_adv, ss.x_rec, ss.norm_label, alpha
    )
    pred, top3, _ = classify_with_base(x_final)
    ss.x_mix = x_mix
    ss.x_final = x_final
    ss.final_mode = mode
    ss.final_pred = pred
    ss.final_top3 = top3


