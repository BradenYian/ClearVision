        st.stop()

    left, right = st.columns([1, 1.15], gap="large")
    with left:
        up_adv = st.file_uploader(
            "Image to scan (clean or attacked)",
            type=["png", "jpg", "jpeg"], key="adv_upload_page1"
        )
    if up_adv is None:
        with right:
            if st.session_state.attack_detected is not None:
                empty_state("Ready for the next scan",
                            "Your last scan is still available in <b>Attack profile</b>, <b>Purification</b>, "
                            "and <b>Verdict and report</b>. Upload a new image to replace it.")
            else:
                empty_state("No image yet",
                            "Upload an attacked image (FGSM or PGD, L∞ or L2) or a clean one. "
                            "Clean images are passed through without running the defense.")
    if up_adv is not None:
        img_bgr = decode_image(up_adv)
        if img_bgr is None:
            outcome("bad", "<b>This file could not be read as an image.</b> Upload a PNG or JPG file.")
            st.stop()
        x_input, img32 = to_cifar(img_bgr)
        # Hash upload content, not just filename, so different images cannot
        # reuse reconstruction/mix/final predictions from a previous upload.
        signature = (hashlib.sha256(up_adv.getvalue()).hexdigest(), binary_threshold)
        if (st.session_state.upload_digest != signature
                or st.session_state.attack_detected is None):
            reset_uploaded_image_state()
            st.session_state.x_adv = x_input
            st.session_state.img32_adv = img32
            try:
                is_attacked, p_attacked = detect_attack(x_input)
            except Exception as e:
                outcome("bad", f"<b>Binary detector prediction failed.</b> {esc(type(e).__name__)}: {esc(e)}")
                st.stop()
            st.session_state.attack_detected = is_attacked
            st.session_state.attack_probability = p_attacked
            st.session_state.upload_digest = signature
        html(rail_html(), rail_slot)

        p_attacked = st.session_state.attack_probability
        attacked = st.session_state.attack_detected is True
        with left:
            html(strip([
                tile(img_bgr, "Uploaded image", f"{img_bgr.shape[1]}×{img_bgr.shape[0]} pixels", kind="bgr"),
                tile(img32, "Model input", "Resized to 32×32 RGB"),
            ]))
        with right:
            color = "var(--cv-red)" if attacked else "var(--cv-green)"
            chip = ('<span class="cv-chip red">Attack detected</span>' if attacked
                    else '<span class="cv-chip green">No attack detected</span>')
            html(f'''<div class="cv-card">
                <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap">
                  <div><div class="cv-kicker">Attack detector</div>
                  <div class="cv-big" style="color:{color}">{p_attacked:.1%}</div>
                  <div style="color:var(--cv-muted);font-size:.92rem;margin-top:4px">probability the image was attacked</div></div>
                  {chip}
                </div>
                <div class="cv-meter"><div class="f" style="width:{p_attacked * 100:.1f}%;background:{color}"></div>
                  <div class="thr" style="left:{binary_threshold * 100:.1f}%"><i>Threshold {binary_threshold:.2f}</i></div></div>
              </div>''')

        if st.session_state.attack_detected is False:
            with right:
                outcome("good", "<b>Clean image. Defense skipped.</b> No perturbation estimate, heatmap, attack type, "
                                "norm, reconstruction, or blending was computed. Use <b>Clean baseline</b> if you want "
                                "a baseline classification of this image.")
            st.stop()

        missing = [
            name for name, model_object in (
                (DELTA_MODEL_PATH, D_adv),
                (RECONSTRUCTOR_PATH, R),
                (NORM_CLASSIFIER_PATH, norm_clf),
                (CLASSIFIER_PATH, clf),
            ) if model_object is None
        ]
        if missing:
            outcome("bad", "<b>Attack detected, but the defense cannot finish.</b> Not loaded: "
                    + ", ".join(f"<code>{esc(m)}</code>" for m in missing))
            st.stop()
        if attack_type_clf is None:
            outcome("warn", "<b>FGSM/PGD model is missing.</b> The attack type will be unavailable; the rest of the defense still runs.")

        if st.session_state.x_rec is None:
            with st.spinner("Attack detected. Isolating the perturbation, profiling the attack, and reconstructing the image..."):
                try:
                    delta = np.asarray(D_adv.predict(x_input, verbose=0)[0],
                                       dtype=np.float32)
                    if delta.shape != (32, 32, 3) or not np.isfinite(delta).all():
                        raise ValueError(f"Unexpected delta output: {delta.shape}")
                    hm, _, _ = delta_heatmap(delta)
                    attack_result = compute_attack_type_from_delta(delta)
                    norm_label, norm_probs2 = compute_norm_from_attacked(x_input)
                    if norm_label not in ("Linf", "L2"):
                        raise ValueError("Norm classifier did not return Linf/L2")
                    x_rec = compute_reconstruction(x_input, delta)
                    if x_rec is None or x_rec.shape != (32, 32, 3):
                        raise ValueError("Reconstruction missing or has wrong shape")
                    # Commit successful results together, to avoid partial stale state.
                    st.session_state.delta = delta
                    st.session_state.delta_hm = hm
                    st.session_state.attack_type = attack_result[0] if attack_result else None
                    st.session_state.attack_type_probs = attack_result[1] if attack_result else None
                    st.session_state.norm_label = norm_label
                    st.session_state.norm_probs2 = norm_probs2
                    st.session_state.x_rec = x_rec
                except Exception as e:
                    outcome("bad", f"<b>Defense pipeline failed.</b> {esc(type(e).__name__)}: {esc(e)}")
                    st.stop()

        # Always refresh x_mix / x_final when alpha changes. Expensive models
        # do not run again for a previously analyzed image.
        try:
            update_final_from_reconstruction(mix_alpha)
        except Exception as e:
            outcome("bad", f"<b>Final classification failed.</b> {esc(type(e).__name__)}: {esc(e)}")
            st.stop()
        html(rail_html(), rail_slot)

        ss = st.session_state
        attacked_base_pred, _, _ = classify_with_base(ss.img32_adv)
        clean_base_pred = None
        if ss.img32_clean is not None:
            clean_base_pred, _, _ = classify_with_base(ss.img32_clean)

        html('<div style="height:.6rem"></div>')
        section("Before and after", "The same classifier, with and without ClearVision in front of it.")
        html(f'''<div class="cv-ba">
          <div class="cv-ba-side bad"><img src="{data_uri(ss.img32_adv)}" alt="Attacked input">
            <div><div class="k">Without ClearVision</div><div class="l">{esc(attacked_base_pred[0])}</div>
            <div class="c cv-num">{attacked_base_pred[1]:.1%} confidence on the attacked input</div></div></div>
          <div class="cv-ba-side good"><img src="{data_uri(ss.x_final)}" alt="Defended image">
            <div><div class="k">With ClearVision</div><div class="l">{esc(ss.final_pred[0])}</div>
            <div class="c cv-num">{ss.final_pred[1]:.1%} confidence on the purified image</div></div></div>
        </div>''')
        if clean_base_pred is not None:
            if clean_base_pred[0] == ss.final_pred[0]:
                outcome("good", f"<b>Original answer restored.</b> The clean baseline is <b>{esc(clean_base_pred[0])}</b> "
                                f"({clean_base_pred[1]:.1%}), and the defended image is classified as "
                                f"<b>{esc(ss.final_pred[0])}</b> again.")
            else:
                outcome("warn", f"<b>Defended answer differs from the clean baseline.</b> Clean baseline: "
                                f"<b>{esc(clean_base_pred[0])}</b> ({clean_base_pred[1]:.1%}). Defended: "
                                f"<b>{esc(ss.final_pred[0])}</b> ({ss.final_pred[1]:.1%}).")
        else:
            outcome("info", "<b>Tip:</b> upload the original image in <b>Clean baseline</b> to confirm that the defended "
                            "answer matches the unattacked one.")

        col_a, col_b = st.columns([1, 1], gap="large")
        with col_a:
            with box():
                section("Attack profile")
                html(f'''<table class="cv-kv">
                  <tr><td>Attack method</td><td>{esc((ss.attack_type or "Unavailable").upper())}</td></tr>
                  <tr><td>Perturbation norm</td><td>{esc(norm_display(ss.norm_label))}</td></tr>
                  <tr><td>Defense applied</td><td>{esc(friendly_mode(ss.norm_label, mix_alpha))}</td></tr>
                  <tr><td>Pipeline mode</td><td><code>{esc(ss.final_mode)}</code></td></tr>
                </table>''')
        with col_b:
            with box():
                section("Top 3 final classes", "Classifier confidence on the purified image.")
                html(bars_html(ss.final_top3, tone="green"))

        section("What the defense did", "Left to right: the input, the perturbation ClearVision isolated, and the reconstructed image.")
        tiles = [
            tile(ss.img32_adv, "Uploaded input", "32×32, as the attacker sent it", tone="red"),
            tile(ss.delta_hm, "Isolated perturbation", "Heatmap of |δ̂|, brighter is stronger", kind="uint8"),
            tile(ss.x_rec, "Reconstruction", "Attack removed",
                 tone="green" if ss.x_mix is None else "", tag="Sent to classifier" if ss.x_mix is None else ""),
        ]
        if ss.x_mix is not None:
            tiles.append(tile(ss.x_mix, "L2 blend", f"α = {mix_alpha:.2f} input + {1 - mix_alpha:.2f} reconstruction",
                              tone="green", tag="Sent to classifier"))
        html(strip(tiles))
        st.caption(
            f"Delta statistics: min={ss.delta.min():.4f}, max={ss.delta.max():.4f}, "
            f"mean|delta|={np.mean(np.abs(ss.delta)):.5f}, "
            f"max|delta|={np.max(np.abs(ss.delta)):.4f}"
        )
        if ss.img32_clean is not None:
            st.caption(f"Base classifier on unprotected attacked input: {attacked_base_pred[0]} ({attacked_base_pred[1]:.2%}). "
                       f"Page 0 clean baseline: {clean_base_pred[0]} ({clean_base_pred[1]:.2%}).")
        downloads_block([
            ("Delta heatmap (PNG)", png_bytes_from_rgb(ss.delta_hm.astype(np.uint8)), "delta_heatmap.png", "image/png"),
            ("Delta array (.npy)", npy_download(ss.delta), "delta.npy", "application/octet-stream"),
            ("Reconstructed image (PNG)", png_bytes_from_float01(ss.x_rec), "reconstructed.png", "image/png"),
            ("Final image (PNG)", png_bytes_from_float01(ss.x_final), "final_used_for_classification.png", "image/png"),
        ])
        nav_footer("baseline", "profile")


elif page == "profile":
    page_header(3, "Attack profile",
                "ClearVision identifies how the image was attacked. The norm decides how the purified image is "
                "prepared for the classifier, so this step changes the defense itself.")
    ensure_attacked_for_pages()
    if st.session_state.x_adv is None:
        empty_state("Nothing scanned yet", "Upload an attacked image in <b>Scan and defend</b> first.")
        st.stop()
    rail_slot = st.empty()
    x_adv = st.session_state.x_adv
    norm_label, norm_probs2 = compute_norm_from_attacked(x_adv)
    st.session_state.norm_label = norm_label
    st.session_state.norm_probs2 = norm_probs2
    html(rail_html(), rail_slot)
    if norm_label is None or norm_probs2 is None:
        outcome("warn", "<b>Norm classifier not available, or its output could not be interpreted.</b>")
        st.stop()

    col_a, col_b = st.columns([1, 1], gap="large")
    with col_a:
        with box():
            html(f'<div class="cv-kicker">Perturbation norm (from the attacked image, not δ̂)</div>'
                 f'<div class="cv-big" style="color:var(--cv-blue);margin-bottom:.9rem">{esc(norm_display(norm_label))}</div>')
            rows = sorted([("L∞ (Linf)", float(norm_probs2[0])), ("L2", float(norm_probs2[1]))], key=lambda r: -r[1])
            html(bars_html(rows))
            html('''<table class="cv-kv" style="margin-top:1rem">
              <tr><td>L∞ attack</td><td style="font-weight:500">Every pixel is nudged by a tiny, capped amount. Spread evenly across the whole image.</td></tr>
              <tr><td>L2 attack</td><td style="font-weight:500">The total size of the change is capped. Changes can be concentrated in fewer pixels.</td></tr>
            </table>''')
    with col_b:
        with box():
            ap = st.session_state.attack_type_probs
            at = st.session_state.attack_type
            html(f'<div class="cv-kicker">Attack method (from δ̂)</div>'
                 f'<div class="cv-big" style="color:var(--cv-blue);margin-bottom:.9rem">{esc((at or "Unavailable").upper())}</div>')
            if ap is not None and len(np.asarray(ap).reshape(-1)) == len(ATTACK_LABELS):
                apv = np.asarray(ap, dtype=np.float32).reshape(-1)
                rows = sorted([(ATTACK_LABELS[i].upper(), float(apv[i])) for i in range(len(ATTACK_LABELS))], key=lambda r: -r[1])
                html(bars_html(rows))
            else:
                st.caption("Attack-type probabilities are unavailable for this scan.")
            html('''<table class="cv-kv" style="margin-top:1rem">
              <tr><td>FGSM</td><td style="font-weight:500">Fast Gradient Sign Method. One large step in the direction that most confuses the model.</td></tr>
              <tr><td>PGD</td><td style="font-weight:500">Projected Gradient Descent. Many small, refined steps; a stronger attack.</td></tr>
            </table>''')

    if norm_label == "L2":
        outcome("info", f"<b>Norm is L2, so the defense will blend.</b> The final image is "
                        f"α × input + (1 − α) × reconstruction, with α = {mix_alpha:.2f} (set in the sidebar).")
    else:
        outcome("info", "<b>Norm is L∞, so the defense will not blend.</b> The reconstructed image is sent to the classifier directly.")
    st.caption(f"Predicted norm: {norm_label} (forced to only Linf or L2). Linf: {float(norm_probs2[0]):.3f}, L2: {float(norm_probs2[1]):.3f}")
    nav_footer("scan", "purify")


elif page == "purify":
    page_header(4, "Purification",
                "ClearVision reconstructs the image from the attacked input and the perturbation it isolated. "
                "For L2 attacks, the reconstruction is blended with the input before classification.")
    ensure_attacked_for_pages()
    if st.session_state.x_adv is None or st.session_state.delta is None:
        empty_state("Nothing scanned yet", "Upload an attacked image in <b>Scan and defend</b> first.")
        st.stop()
    if R is None:
        outcome("warn", "<b>Reconstructor not loaded.</b>")
        st.stop()
    rail_slot = st.empty()
    x_adv = st.session_state.x_adv
    delta = st.session_state.delta
    x_rec = st.session_state.x_rec
    if x_rec is None:
        x_rec = compute_reconstruction(x_adv, delta)
        if x_rec is None:
            outcome("bad", "<b>Could not compute reconstruction.</b>")
            st.stop()
        st.session_state.x_rec = x_rec
    if st.session_state.norm_label is None or st.session_state.norm_probs2 is None:
        nl, np2 = compute_norm_from_attacked(x_adv)
        st.session_state.norm_label = nl
        st.session_state.norm_probs2 = np2
    norm_label = st.session_state.norm_label
    if norm_label is None:
        outcome("warn", "<b>Norm label unavailable; cannot decide whether to blend.</b>")
        st.stop()
    x_mix, x_final, final_mode = compute_mix_if_needed(x_adv, x_rec, norm_label, mix_alpha)
    st.session_state.x_mix = x_mix
    st.session_state.x_final = x_final
    st.session_state.final_mode = final_mode
    html(rail_html(), rail_slot)

    tiles = [
        tile(st.session_state.img32_adv, "Attacked input", "x_adv, 32×32", tone="red"),
        tile(st.session_state.delta_hm, "Isolated perturbation", "|δ̂| heatmap", kind="uint8"),
        tile(x_rec, "Reconstructed", "x_rec", tone="green" if x_mix is None else "",
             tag="Sent to classifier" if x_mix is None else ""),
    ]
    if x_mix is not None:
        tiles.append(tile(x_mix, "L2 blend", "x_mix, only for L2 attacks", tone="green", tag="Sent to classifier"))
    html(strip(tiles))

    with box():
        section("Image sent to the classifier")
        html(f'''<table class="cv-kv">
          <tr><td>Predicted norm</td><td>{esc(norm_display(norm_label))}</td></tr>
          <tr><td>Defense applied</td><td>{esc(friendly_mode(norm_label, mix_alpha))}</td></tr>
          <tr><td>Blend rule (L2 only)</td><td><code>x_mix = alpha*x_adv + (1-alpha)*x_rec</code></td></tr>
          <tr><td>Final input selection</td><td><code>{esc(final_mode)}</code></td></tr>
        </table>''')
    dl = [
        ("Reconstructed image (PNG)", png_bytes_from_float01(x_rec), "reconstructed.png", "image/png"),
        ("Reconstructed array (.npy)", npy_download(x_rec), "reconstructed.npy", "application/octet-stream"),
    ]
    if x_mix is not None:
        dl += [
            ("Blended image (PNG)", png_bytes_from_float01(x_mix), "mixed.png", "image/png"),
            ("Blended array (.npy)", npy_download(x_mix), "mixed.npy", "application/octet-stream"),
        ]
    downloads_block(dl)
    nav_footer("profile", "verdict")


elif page == "verdict":
    page_header(5, "Verdict and report",
                "The final classification of the purified image, with every intermediate result available for review and download.")
    ensure_attacked_for_pages()
    if st.session_state.x_adv is None or st.session_state.delta is None:
        empty_state("Nothing scanned yet", "Upload an attacked image in <b>Scan and defend</b> first.")
        st.stop()
    if R is None:
        outcome("warn", "<b>Reconstructor not loaded; cannot compute the final defense output.</b>")
        st.stop()
    if clf is None:
        outcome("warn", "<b>Base classifier not loaded.</b>")
        st.stop()
    rail_slot = st.empty()
    if st.session_state.x_rec is None:
        st.session_state.x_rec = compute_reconstruction(
            st.session_state.x_adv, st.session_state.delta
        )
    if st.session_state.norm_label is None:
        nl, np2 = compute_norm_from_attacked(st.session_state.x_adv)
        st.session_state.norm_label = nl
        st.session_state.norm_probs2 = np2
    if st.session_state.norm_label not in ("Linf", "L2"):
        outcome("warn", "<b>Norm label unavailable; cannot select the final image.</b>")
        st.stop()
    update_final_from_reconstruction(mix_alpha)
    norm_label = st.session_state.norm_label
    final_mode = st.session_state.final_mode
    pred, top3 = st.session_state.final_pred, st.session_state.final_top3
    html(rail_html(), rail_slot)

    ss = st.session_state
    attacked_base_pred, _, _ = classify_with_base(ss.img32_adv)
    col_a, col_b = st.columns([1, 1.1], gap="large")
    with col_a:
        html(verdict_html("Final answer with ClearVision", pred[0], pred[1], tone="good",
                          note=f"Without ClearVision the classifier said {attacked_base_pred[0]} ({attacked_base_pred[1]:.1%})."))
        with box():
            section("Top 3 classes")
            html(bars_html(top3, tone="green"))
    with col_b:
        with box():
            section("Technical summary")
            at = ss.attack_type
            np2 = ss.norm_probs2
            norm_row = (f"L∞ {float(np2[0]):.3f}, L2 {float(np2[1]):.3f}" if np2 is not None else "Unavailable")
            p_att = ss.attack_probability
            html(f'''<table class="cv-kv">
              <tr><td>Detector, P(attacked)</td><td>{p_att:.1%} (threshold {binary_threshold:.2f})</td></tr>
              <tr><td>Attack type (from δ̂)</td><td>{esc(at.upper() if at is not None else "Unavailable")}</td></tr>
              <tr><td>Norm</td><td>{esc(norm_display(norm_label))}</td></tr>
              <tr><td>Norm probabilities (forced L∞ vs L2)</td><td>{esc(norm_row)}</td></tr>
              <tr><td>Final mode</td><td><code>{esc(final_mode)}</code></td></tr>
              <tr><td>Final prediction</td><td>{esc(pred[0])} ({pred[1]:.2f})</td></tr>
            </table>''')

    section("Artifacts", "Every image the pipeline produced for this scan.")
    tiles = [
        tile(ss.img32_adv, "Attacked", "x_adv", tone="red"),
        tile(ss.x_rec, "Reconstructed", "x_rec"),
    ]
    if ss.x_mix is not None:
        tiles.append(tile(ss.x_mix, "Blended", "x_mix, only for L2"))
    tiles.append(tile(ss.x_final, "Final input", "The image that was classified", tone="green", tag=f"Classified as {pred[0]}"))
    html(strip(tiles))
    st.caption("The blended image only exists (and is used) when the predicted norm is L2.")

    dl = [
        ("Final image (PNG)", png_bytes_from_float01(ss.x_final), "final_used_for_classification.png", "image/png"),
        ("Final array (.npy)", npy_download(np.asarray(ss.x_final, dtype=np.float32)), "final_used_for_classification.npy", "application/octet-stream"),
    ]
    if ss.delta_hm is not None:
        dl.append(("Delta heatmap (PNG)", png_bytes_from_rgb(ss.delta_hm.astype(np.uint8)), "delta_heatmap.png", "image/png"))
    if ss.delta is not None:
        dl.append(("Delta array (.npy)", npy_download(ss.delta), "delta.npy", "application/octet-stream"))
    downloads_block(dl)
    nav_footer("purify", "scan", "Scan another image")
launch_website()
