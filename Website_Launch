def rail_html(explain=False):
    ss = st.session_state
    det = ss.attack_detected
    stages = []
    if explain:
        stages = [
            ("", "Detect", "Is this image under attack?"),
            ("", "Isolate", "Estimate the hidden perturbation"),
            ("", "Profile", "Identify method (FGSM/PGD) and norm (L∞/L2)"),
            ("", "Purify", "Reconstruct the image without the attack"),
            ("", "Classify", "Return the corrected answer"),
        ]
        body = "".join(
            f'<div class="cv-stage done"><div class="cv-dot">{i + 1}</div><b>{t}</b><span>{d}</span></div>'
            for i, (_, t, d) in enumerate(stages)
        )
        return f'<div class="cv-rail">{body}</div>'

    def node(state, num, title, val, sub):
        icon = {"done": ICON_CHECK, "alert": ICON_ALERT, "clean": ICON_CHECK, "skip": ICON_SKIP}.get(state, str(num))
        return (f'<div class="cv-stage {state}"><div class="cv-dot">{icon}</div><b>{title}</b>'
                f'<span class="cv-val">{val}</span><span>{sub}</span></div>')

    p = ss.attack_probability
    if det is None:
        n1 = node("", 1, "Detect", "Waiting for an image", "Attack detector")
    elif det:
        n1 = node("alert", 1, "Detect", "Attack detected", f"P(attacked) {p:.1%}")
    else:
        n1 = node("clean", 1, "Detect", "No attack", f"P(attacked) {p:.1%}")
    skip = det is False
    if skip:
        rest = [node("skip", i, t, "Not needed", "Skipped for clean images")
                for i, t in [(2, "Isolate"), (3, "Profile"), (4, "Purify"), (5, "Classify")]]
        return f'<div class="cv-rail">{n1}{"".join(rest)}</div>'
    n2 = (node("done", 2, "Isolate", "Perturbation isolated", f"mean |δ̂| {float(np.mean(np.abs(ss.delta))):.4f}")
          if ss.delta is not None else node("", 2, "Isolate", "Pending", "Perturbation estimator"))
    if ss.norm_label is not None:
        method = (ss.attack_type or "unknown").upper()
        n3 = node("done", 3, "Profile", f"{method}, {norm_display(ss.norm_label)} norm", "Method and norm identified")
    else:
        n3 = node("", 3, "Profile", "Pending", "Method and norm")
    if ss.x_rec is not None:
        n4 = node("done", 4, "Purify", "Image reconstructed",
                  "Blended with input (L2)" if ss.x_mix is not None else "Used directly (L∞)")
    else:
        n4 = node("", 4, "Purify", "Pending", "Reconstructor")
    if ss.final_pred is not None:
        n5 = node("done", 5, "Classify", esc(ss.final_pred[0]).capitalize(), f"{ss.final_pred[1]:.1%} confidence")
    else:
        n5 = node("", 5, "Classify", "Pending", "Image classifier")
    return f'<div class="cv-rail">{n1}{n2}{n3}{n4}{n5}</div>'


