# =========================
#STUDENT TRAINING WITH TIME-BASED ROLLING CHECKPOINTS
# =========================

import os
import time
import numpy as np
import tensorflow as tf
from tqdm import tqdm


# ---------------------------------------------------------
# CHECKPOINT SETTINGS
# ---------------------------------------------------------

# Save approximately every 120,000 ms = 2 minutes.
CFG.student_checkpoint_every_ms = 120_000

# Retain only the newest three checkpoints.
CFG.max_student_checkpoints = 3

# Training checkpoints are separate from the final .keras model.
CFG.student_checkpoint_dir = "./delta_student_checkpoints"


STUDENT_CHECKPOINT_EVERY_MS = getattr(
    CFG,
    "student_checkpoint_every_ms",
    5 * 60 * 1000,
)

MAX_STUDENT_CHECKPOINTS = getattr(
    CFG,
    "max_student_checkpoints",
    3,
)

STUDENT_CHECKPOINT_DIR = getattr(
    CFG,
    "student_checkpoint_dir",
    os.path.splitext(CFG.student_path)[0] + "_checkpoints",
)


# Change this to True only when you intentionally want to discard
# all saved student training progress.
FORCE_FRESH_STUDENT = False


if STUDENT_CHECKPOINT_EVERY_MS <= 0:
    raise ValueError(
        "STUDENT_CHECKPOINT_EVERY_MS must be greater than zero."
    )

if MAX_STUDENT_CHECKPOINTS <= 0:
    raise ValueError(
        "MAX_STUDENT_CHECKPOINTS must be greater than zero."
    )


# ---------------------------------------------------------
# OPTIONAL RESET
# ---------------------------------------------------------

if FORCE_FRESH_STUDENT and tf.io.gfile.exists(STUDENT_CHECKPOINT_DIR):
    tf.io.gfile.rmtree(STUDENT_CHECKPOINT_DIR)
    print(
        "Deleted existing student training checkpoints:",
        STUDENT_CHECKPOINT_DIR,
    )

tf.io.gfile.makedirs(STUDENT_CHECKPOINT_DIR)


# ---------------------------------------------------------
# CHECKPOINTED TRAINING STATE
# ---------------------------------------------------------

# Current epoch, using the same 1-based numbering as the training loop.
student_checkpoint_epoch = tf.Variable(
    1,
    dtype=tf.int64,
    trainable=False,
    name="student_checkpoint_epoch",
)

# Number of successfully completed batches in the current epoch.
student_checkpoint_batch = tf.Variable(
    0,
    dtype=tf.int64,
    trainable=False,
    name="student_checkpoint_batch",
)

# Total number of successfully completed student training batches.
student_global_step = tf.Variable(
    0,
    dtype=tf.int64,
    trainable=False,
    name="student_global_step",
)


# Running epoch metrics:
# [
#     total,
#     loss_delta,
#     loss_adv,
#     loss_cons,
#     loss_l1,
# ]
#
# Saving these means the printed epoch average remains correct after
# resuming in the middle of an epoch.
student_metric_sum = tf.Variable(
    tf.zeros([5], dtype=tf.float32),
    trainable=False,
    name="student_metric_sum",
)

student_metric_count = tf.Variable(
    0,
    dtype=tf.int64,
    trainable=False,
    name="student_metric_count",
)


# ---------------------------------------------------------
# CREATE CHECKPOINT
# ---------------------------------------------------------

# This checkpoint contains:
#   - D_adv model weights
#   - Adam optimizer state
#   - current epoch
#   - current batch position
#   - global step
#   - running epoch metrics
student_checkpoint = tf.train.Checkpoint(
    model=D_adv,
    optimizer=optS,
    epoch=student_checkpoint_epoch,
    batch_in_epoch=student_checkpoint_batch,
    global_step=student_global_step,
    metric_sum=student_metric_sum,
    metric_count=student_metric_count,
)

student_checkpoint_manager = tf.train.CheckpointManager(
    checkpoint=student_checkpoint,
    directory=STUDENT_CHECKPOINT_DIR,
    max_to_keep=MAX_STUDENT_CHECKPOINTS,
    checkpoint_name="delta_student",
)


# ---------------------------------------------------------
# RESTORE LATEST CHECKPOINT
# ---------------------------------------------------------

if student_checkpoint_manager.latest_checkpoint:
    restore_status = student_checkpoint.restore(
        student_checkpoint_manager.latest_checkpoint
    )

    # Adam's slot variables might not exist until the first optimizer
    # update. TensorFlow will restore them when they are created.
    restore_status.expect_partial()

    print("Restored student checkpoint:")
    print(" ", student_checkpoint_manager.latest_checkpoint)
    print(
        "  Resume epoch:",
        int(student_checkpoint_epoch.numpy()),
    )
    print(
        "  Resume batch:",
        int(student_checkpoint_batch.numpy()),
    )
    print(
        "  Global step:",
        int(student_global_step.numpy()),
    )
    print(
        "  Saved metric batches:",
        int(student_metric_count.numpy()),
    )
else:
    print("No student checkpoint found. Starting from scratch.")


# ---------------------------------------------------------
# CHECKPOINT SAVE FUNCTION
# ---------------------------------------------------------

def save_student_checkpoint(reason):
    """
    Save the student model, Adam optimizer, training position,
    and running metric state.
    """

    checkpoint_path = student_checkpoint_manager.save()

    print(
        f"\nStudent checkpoint saved ({reason}):"
        f"\n  path={checkpoint_path}"
        f"\n  epoch={int(student_checkpoint_epoch.numpy())}"
        f"\n  batch={int(student_checkpoint_batch.numpy())}"
        f"\n  global_step={int(student_global_step.numpy())}"
    )

    return checkpoint_path


# ---------------------------------------------------------
# OPTIONAL SANITY CHECK
# ---------------------------------------------------------

xb, yb = next(iter(train_ds))

print("\nStudent checkpoint configuration:")
print(
    "  Save interval:",
    STUDENT_CHECKPOINT_EVERY_MS,
    "ms",
)
print(
    "  Maximum retained checkpoints:",
    MAX_STUDENT_CHECKPOINTS,
)
print(
    "  Checkpoint directory:",
    STUDENT_CHECKPOINT_DIR,
)
print(
    "  Example clean batch shape:",
    xb.shape,
)


# The training function divides each batch into FGSM, PGD, and C&W
# sections. A batch therefore needs at least three examples.
example_batch_size = int(tf.shape(xb)[0].numpy())

if example_batch_size < 3:
    raise ValueError(
        "Student training batches must contain at least three examples "
        "because train_step_student splits each batch into FGSM, PGD, "
        "and C&W sections."
    )


# ---------------------------------------------------------
# TRAINING SETUP
# ---------------------------------------------------------

start_epoch = int(student_checkpoint_epoch.numpy())
resume_batch = int(student_checkpoint_batch.numpy())

checkpoint_interval_ns = (
    int(STUDENT_CHECKPOINT_EVERY_MS) * 1_000_000
)

# monotonic_ns() is unaffected by changes to the system clock.
next_checkpoint_time = (
    time.monotonic_ns() + checkpoint_interval_ns
)


# ---------------------------------------------------------
# STUDENT TRAINING LOOP
# ---------------------------------------------------------

try:
    for epoch in range(
        start_epoch,
        CFG.student_epochs + 1,
    ):
        # Only the first restored epoch can have completed batches.
        first_batch = (
            resume_batch
            if epoch == start_epoch
            else 0
        )

        if first_batch > 0:
            print(
                f"\nResuming student epoch {epoch} "
                f"after batch {first_batch}."
            )

            # Skip batches whose completed state is already represented
            # by the restored model and optimizer.
            epoch_train_ds = train_ds.skip(first_batch)
        else:
            epoch_train_ds = train_ds

        progress = tqdm(
            enumerate(
                epoch_train_ds,
                start=first_batch,
            ),
            desc=(
                f"Student Train "
                f"{epoch}/{CFG.student_epochs}"
            ),
        )

        for batch_index, (xb, yb) in progress:
            current_batch_size = int(
                tf.shape(xb)[0].numpy()
            )

            if current_batch_size < 3:
                raise ValueError(
                    "Encountered a training batch containing fewer "
                    "than three examples. Use drop_remainder=True or "
                    "increase the dataset batch size."
                )

            # Perform one complete student optimizer update.
            output = train_step_student(xb, yb)

            batch_metrics = tf.stack(
                [
                    tf.cast(value, tf.float32)
                    for value in output
                ]
            )

            total = batch_metrics[0]
            loss_delta = batch_metrics[1]
            loss_adv = batch_metrics[2]
            loss_cons = batch_metrics[3]
            loss_l1 = batch_metrics[4]

            # Record metrics only after the optimizer update succeeds.
            student_metric_sum.assign_add(batch_metrics)
            student_metric_count.assign_add(1)

            # Record the exact completed training position.
            student_checkpoint_epoch.assign(epoch)
            student_checkpoint_batch.assign(batch_index + 1)
            student_global_step.assign_add(1)

            progress.set_postfix(
                total=f"{float(total):.4f}",
                delta=f"{float(loss_delta):.4f}",
                adv=f"{float(loss_adv):.4f}",
                cons=f"{float(loss_cons):.4f}",
                step=int(student_global_step.numpy()),
            )

            # Check the timer after a complete optimizer update.
            now = time.monotonic_ns()

            if now >= next_checkpoint_time:
                save_student_checkpoint(
                    reason=(
                        f"{STUDENT_CHECKPOINT_EVERY_MS} "
                        "ms interval"
                    )
                )

                # Start the next interval after checkpoint writing
                # finishes, avoiding repeated immediate saves.
                next_checkpoint_time = (
                    time.monotonic_ns()
                    + checkpoint_interval_ns
                )

        # -------------------------------------------------
        # END-OF-EPOCH METRICS
        # -------------------------------------------------

        completed_metric_batches = int(
            student_metric_count.numpy()
        )

        if completed_metric_batches > 0:
            epoch_metrics = (
                student_metric_sum.numpy()
                / completed_metric_batches
            )
        else:
            epoch_metrics = np.full(
                5,
                np.nan,
                dtype=np.float32,
            )

        print(
            f"\nEpoch {epoch:02d}"
            f" | total={epoch_metrics[0]:.4f}"
            f" delta={epoch_metrics[1]:.4f}"
            f" adv={epoch_metrics[2]:.4f}"
            f" cons={epoch_metrics[3]:.4f}"
            f" l1={epoch_metrics[4]:.4f}"
        )

        # Mark the epoch complete. A restart from the checkpoint
        # created below begins at the next epoch.
        student_checkpoint_epoch.assign(epoch + 1)
        student_checkpoint_batch.assign(0)

        # Reset metric accumulators for the next epoch.
        student_metric_sum.assign(
            tf.zeros([5], dtype=tf.float32)
        )
        student_metric_count.assign(0)

        save_student_checkpoint(
            reason=f"end of epoch {epoch}"
        )

        # Only the initially restored epoch can require skipping.
        resume_batch = 0


# ---------------------------------------------------------
# INTERRUPTION HANDLING
# ---------------------------------------------------------

except KeyboardInterrupt:
    try:
        save_student_checkpoint(
            reason="manual interruption"
        )
        print(
            "\nStudent training was interrupted. "
            "The latest completed batch was checkpointed."
        )
    except Exception as checkpoint_error:
        print(
            "\nStudent training was interrupted, but the "
            "emergency checkpoint failed:",
            checkpoint_error,
        )

    raise


except Exception:
    try:
        save_student_checkpoint(
            reason="training exception"
        )
        print(
            "\nStudent training failed. The latest completed "
            "batch was checkpointed."
        )
    except Exception as checkpoint_error:
        print(
            "\nStudent training failed, and the emergency "
            "checkpoint also failed:",
            checkpoint_error,
        )

    raise


# ---------------------------------------------------------
# FINAL STANDALONE EXPORT
# ---------------------------------------------------------

# This runs only after every requested student epoch completes.
# Use the rolling checkpoint directory to resume training.
# Use CFG.student_path for final inference/deployment.
D_adv.save(CFG.student_path)

print("\nSaved final student model:", CFG.student_path)
print(
    "Rolling student checkpoints are stored in:",
    STUDENT_CHECKPOINT_DIR,
)
