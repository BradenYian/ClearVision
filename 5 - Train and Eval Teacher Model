# =========================
# TIME-BASED ROLLING CHECKPOINTS
# =========================
CFG.checkpoint_every_ms = 120_000
CFG.max_delta_checkpoints = 3
CFG.delta_checkpoint_dir = "./delta_teacher_checkpoints"
import os
import time
import numpy as np
import tensorflow as tf
from tqdm import tqdm


# Checkpoint configuration.
# A checkpoint is attempted after this many milliseconds.
CHECKPOINT_EVERY_MS = getattr(CFG, "checkpoint_every_ms", 5 * 60 * 1000)

# Only retain the newest checkpoints so storage does not grow forever.
MAX_CHECKPOINTS_TO_KEEP = getattr(CFG, "max_delta_checkpoints", 3)

# Checkpoints need a directory, not the final .keras model filename.
DELTA_CHECKPOINT_DIR = getattr(
    CFG,
    "delta_checkpoint_dir",
    os.path.splitext(CFG.delta_path)[0] + "_checkpoints",
)

# Set to True only when you intentionally want to discard all progress.
FORCE_FRESH_TEACHER = False


if CHECKPOINT_EVERY_MS <= 0:
    raise ValueError("CHECKPOINT_EVERY_MS must be greater than zero.")

if MAX_CHECKPOINTS_TO_KEEP <= 0:
    raise ValueError("MAX_CHECKPOINTS_TO_KEEP must be greater than zero.")


if FORCE_FRESH_TEACHER and tf.io.gfile.exists(DELTA_CHECKPOINT_DIR):
    tf.io.gfile.rmtree(DELTA_CHECKPOINT_DIR)
    print("Deleted teacher checkpoints:", DELTA_CHECKPOINT_DIR)

tf.io.gfile.makedirs(DELTA_CHECKPOINT_DIR)


# These variables record exactly where training had reached.
#
# epoch:
#   The next/current epoch to process, using your existing 1-based numbering.
#
# batch_in_epoch:
#   Number of successfully completed batches in the current epoch.
#
# global_step:
#   Total successfully completed training batches.
checkpoint_epoch = tf.Variable(
    1,
    dtype=tf.int64,
    trainable=False,
    name="checkpoint_epoch",
)

checkpoint_batch = tf.Variable(
    0,
    dtype=tf.int64,
    trainable=False,
    name="checkpoint_batch",
)

checkpoint_global_step = tf.Variable(
    0,
    dtype=tf.int64,
    trainable=False,
    name="checkpoint_global_step",
)


# This saves:
#   - D model weights
#   - Adam optimizer state
#   - epoch number
#   - batch position
#   - global training step
teacher_checkpoint = tf.train.Checkpoint(
    model=D,
    optimizer=optD,
    epoch=checkpoint_epoch,
    batch_in_epoch=checkpoint_batch,
    global_step=checkpoint_global_step,
)

checkpoint_manager = tf.train.CheckpointManager(
    checkpoint=teacher_checkpoint,
    directory=DELTA_CHECKPOINT_DIR,
    max_to_keep=MAX_CHECKPOINTS_TO_KEEP,
    checkpoint_name="delta_teacher",
)


# =========================
# RESTORE MOST RECENT CHECKPOINT
# =========================

if checkpoint_manager.latest_checkpoint:
    restore_status = teacher_checkpoint.restore(
        checkpoint_manager.latest_checkpoint
    )

    # Optimizer slot variables can be restored later, after TensorFlow creates
    # them during the first optimizer update.
    restore_status.expect_partial()

    print("Restored teacher checkpoint:")
    print(" ", checkpoint_manager.latest_checkpoint)
    print("  Resume epoch:", int(checkpoint_epoch.numpy()))
    print("  Resume batch:", int(checkpoint_batch.numpy()))
    print("  Global step :", int(checkpoint_global_step.numpy()))
else:
    print("No teacher checkpoint found. Starting from scratch.")


def save_teacher_checkpoint(reason):
    """Save a rolling checkpoint and report its location."""
    checkpoint_path = checkpoint_manager.save(
        checkpoint_number=int(checkpoint_global_step.numpy())
    )

    print(
        f"\nCheckpoint saved ({reason}): {checkpoint_path}\n"
        f"  epoch={int(checkpoint_epoch.numpy())}, "
        f"batch={int(checkpoint_batch.numpy())}, "
        f"global_step={int(checkpoint_global_step.numpy())}"
    )

    return checkpoint_path


# =========================
# SANITY CHECK
# =========================

xb, yb = next(iter(train_ds))
x_adv = make_adv_batch(xb, yb, "fgsm")

print("clean range:", float(tf.reduce_min(xb)), float(tf.reduce_max(xb)))
print("adv   range:", float(tf.reduce_min(x_adv)), float(tf.reduce_max(x_adv)))
print("mean |delta|:", float(tf.reduce_mean(tf.abs(x_adv - xb))))


# =========================
# TRAINING WITH TIME-BASED CHECKPOINTS
# =========================

start_epoch = int(checkpoint_epoch.numpy())
resume_batch = int(checkpoint_batch.numpy())

# monotonic_ns() is unaffected by system-clock changes.
checkpoint_interval_ns = int(CHECKPOINT_EVERY_MS) * 1_000_000
next_checkpoint_time = time.monotonic_ns() + checkpoint_interval_ns


try:
    for epoch in range(start_epoch, CFG.delta_epochs + 1):
        tr = []

        # Skip batches already completed before an interruption.
        first_batch = resume_batch if epoch == start_epoch else 0

        if first_batch > 0:
            print(
                f"\nResuming epoch {epoch} after batch {first_batch}. "
                "Previously completed batches will be skipped."
            )
            epoch_train_ds = train_ds.skip(first_batch)
        else:
            epoch_train_ds = train_ds

        progress = tqdm(
            enumerate(epoch_train_ds, start=first_batch),
            desc=f"Teacher Train {epoch}/{CFG.delta_epochs}",
        )

        for batch_index, (xb, yb) in progress:
            total, l_delta, l_adv, l1 = train_step_teacher(xb, yb)

            tr.append(
                [
                    float(total),
                    float(l_delta),
                    float(l_adv),
                    float(l1),
                ]
            )

            # Update progress only after this batch completed successfully.
            checkpoint_epoch.assign(epoch)
            checkpoint_batch.assign(batch_index + 1)
            checkpoint_global_step.assign_add(1)

            progress.set_postfix(
                total=f"{float(total):.4f}",
                step=int(checkpoint_global_step.numpy()),
            )

            # Check wall-clock time after each completed batch.
            now = time.monotonic_ns()

            if now >= next_checkpoint_time:
                save_teacher_checkpoint(
                    reason=f"{CHECKPOINT_EVERY_MS} ms interval"
                )

                # Schedule relative to the end of this save. This avoids
                # repeatedly saving when checkpoint writing itself is slow.
                next_checkpoint_time = (
                    time.monotonic_ns() + checkpoint_interval_ns
                )

        if tr:
            tr = np.mean(tr, axis=0)
        else:
            # This can happen when restoring from a checkpoint taken after the
            # final training batch but before validation completed.
            tr = np.array([np.nan, np.nan, np.nan, np.nan])


        def eval_attack(name):
            ev = []

            for xb, yb in val_ds:
                out = eval_step_teacher(xb, yb, name)
                ev.append([float(x) for x in out])

            if not ev:
                return np.full(6, np.nan, dtype=np.float32)

            return np.mean(ev, axis=0)


        fg = eval_attack("fgsm")
        pg = eval_attack("pgd")

        print(
            f"\nEpoch {epoch:02d}: "
            f"train total={tr[0]:.4f} "
            f"(delta={tr[1]:.4f} "
            f"adv={tr[2]:.4f} "
            f"l1={tr[3]:.4f})"
        )

        print(
            f"  Val FGSM: "
            f"total={fg[0]:.4f} "
            f"delta_loss={fg[1]:.4f} "
            f"adv_loss={fg[2]:.4f} "
            f"delta_MAE={fg[3]:.4f} "
            f"maxErr={fg[4]:.4f} "
            f"PSNR(xadv)={fg[5]:.2f}"
        )

        print(
            f"  Val PGD : "
            f"total={pg[0]:.4f} "
            f"delta_loss={pg[1]:.4f} "
            f"adv_loss={pg[2]:.4f} "
            f"delta_MAE={pg[3]:.4f} "
            f"maxErr={pg[4]:.4f} "
            f"PSNR(xadv)={pg[5]:.2f}"
        )

        # Mark this epoch complete. A restart now begins at the next epoch.
        checkpoint_epoch.assign(epoch + 1)
        checkpoint_batch.assign(0)

        save_teacher_checkpoint(reason=f"end of epoch {epoch}")

        # Only the first restored epoch can contain a resume position.
        resume_batch = 0


except KeyboardInterrupt:
    # Save once more when stopping manually with Ctrl+C or notebook interrupt.
    save_teacher_checkpoint(reason="manual interruption")
    print("\nTraining interrupted. Progress was checkpointed.")
    raise

except Exception:
    # Make a best effort to retain the last successfully completed batch.
    save_teacher_checkpoint(reason="exception")
    print("\nTraining failed. Last completed progress was checkpointed.")
    raise


# =========================
# FINAL EXPORT
# =========================

# This is the final standalone model used for inference.
# Training restoration uses DELTA_CHECKPOINT_DIR instead.
D.save(CFG.delta_path)

print("Saved final teacher delta predictor:", CFG.delta_path)
print("Rolling checkpoints are stored in:", DELTA_CHECKPOINT_DIR)
